// generated by CMake configure_file (paths are absolute).
#include <windows.h>

// icon 1 = DefaultIcon ("ycgrid.exe",0)
1 ICON "@YC_ICON_PATH@"

// Fluent UI System Icons font (MIT), embedded in the exe: portable, no external files
101 RCDATA "@YC_FLUENT_TTF@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040404b0"
    BEGIN
      VALUE "FileDescription", "YCGrid"
      VALUE "ProductName", "YCGrid"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "LegalCopyright", "Copyright 2026 YCT. Licensed under the Apache License 2.0; third-party notices in licenses\\THIRD-PARTY-NOTICES.md."
      VALUE "LegalTrademarks", "Microsoft, Excel and Office are trademarks of the Microsoft group of companies. YCGrid is not affiliated with Microsoft."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0404, 1200
  END
END
