# The Visual Studio solution at the repository root (ycgrid.slnx), from the one CMake generates in build/vs2026:
# the same projects, their paths made relative to the root. Run by scripts/make_sln.cmd:
#   cmake -DIN=build/vs2026/YCGrid.slnx -DOUT=ycgrid.slnx -DPREFIX=build/vs2026/ -P cmake/YcRootSolution.cmake
if(NOT IN OR NOT OUT OR NOT PREFIX)
  message(FATAL_ERROR "YcRootSolution.cmake needs -DIN, -DOUT and -DPREFIX")
endif()
file(READ "${IN}" sln)
# every project path (Path="src/yc_core.vcxproj", Project="ZERO_CHECK.vcxproj") gets the build folder in front
string(REGEX REPLACE "(Path|Project)=\"([^\"]+\\.vcxproj)\"" "\\1=\"${PREFIX}\\2\"" sln "${sln}")
string(REPLACE "<Solution>" "<!-- Generated by scripts\\make_sln.cmd from ${PREFIX}YCGrid.slnx: run it again after adding a target. -->\n<Solution>" sln "${sln}")
file(WRITE "${OUT}" "${sln}")
